#!/usr/bin/env bash
set -euo pipefail

launcher_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
project_root="$(cd -- "$(dirname -- "$launcher_path")/.." && pwd)"
cli="$project_root/.venv/bin/secretloom"
port="${SECRETLOOM_PORT:-5000}"
url="http://127.0.0.1:$port"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/secretloom"
pid_file="$state_root/server.pid"
log_file="$state_root/server.log"
service_name="secretloom-${port}.service"

usage() {
  cat <<'EOF'
SecretLoom launcher

Usage:
  secretloom              Open the local SecretLoom workbench
  secretloom --app        Open it in an app-style browser window
  secretloom --cli        Open the interactive terminal interface
  secretloom --status     Report the local workbench status
  secretloom --stop       Stop the launcher-managed local server
  secretloom <command>    Run any SecretLoom CLI command

Set SECRETLOOM_PORT to use a port other than 5000.
EOF
}

require_install() {
  if [[ ! -x "$cli" ]]; then
    printf 'SecretLoom is not installed in %s/.venv.\nRun: %s/install.sh\n' "$project_root" "$project_root" >&2
    exit 1
  fi
}

is_secretloom_ready() {
  curl --fail --silent --show-error --max-time 1 "$url/api/health" 2>/dev/null \
    | grep -Eq '"product"[[:space:]]*:[[:space:]]*"SecretLoom"'
}

systemd_user_available() {
  command -v systemctl >/dev/null 2>&1 \
    && command -v systemd-run >/dev/null 2>&1 \
    && systemctl --user show-environment >/dev/null 2>&1
}

read_managed_pid() {
  [[ -r "$pid_file" ]] || return 1
  local pid
  pid="$(<"$pid_file")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s' "$pid"
}

stop_server() {
  local pid
  if systemd_user_available && systemctl --user is-active --quiet "$service_name"; then
    systemctl --user stop "$service_name"
    rm -f -- "$pid_file"
    printf 'SecretLoom stopped.\n'
    return 0
  fi

  if ! pid="$(read_managed_pid)"; then
    rm -f -- "$pid_file"
    if is_secretloom_ready; then
      printf 'SecretLoom is running on %s, but it was not started by this launcher.\n' "$url"
      return 1
    fi
    printf 'SecretLoom is not running.\n'
    return 0
  fi

  kill "$pid"
  for _ in {1..50}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f -- "$pid_file"
      printf 'SecretLoom stopped.\n'
      return 0
    fi
    sleep 0.1
  done

  printf 'SecretLoom did not stop cleanly; process %s is still running.\n' "$pid" >&2
  return 1
}

start_server() {
  require_install
  mkdir -p -- "$state_root"

  if is_secretloom_ready; then
    return 0
  fi

  if curl --fail --silent --max-time 1 "$url" >/dev/null 2>&1; then
    printf 'Port %s is already occupied by another application. Set SECRETLOOM_PORT to a free port.\n' "$port" >&2
    return 1
  fi

  local server_pid=""
  local managed_by_systemd=false
  if systemd_user_available; then
    rm -f -- "$pid_file"
    systemctl --user reset-failed "$service_name" >/dev/null 2>&1 || true
    systemd-run --user \
      --unit="${service_name%.service}" \
      --collect \
      --quiet \
      --working-directory="$project_root" \
      --property=Type=exec \
      --property=Restart=on-failure \
      --property=RestartSec=1 \
      --property="StandardOutput=append:$log_file" \
      --property="StandardError=append:$log_file" \
      "$cli" web --port "$port" --skip-banner
    managed_by_systemd=true
  else
    nohup "$cli" web --port "$port" --skip-banner >>"$log_file" 2>&1 </dev/null &
    server_pid=$!
    printf '%s\n' "$server_pid" >"$pid_file"
  fi

  for _ in {1..100}; do
    if is_secretloom_ready; then
      return 0
    fi
    if [[ "$managed_by_systemd" == true ]]; then
      systemctl --user is-active --quiet "$service_name" || break
    elif ! kill -0 "$server_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done

  printf 'SecretLoom could not start. Recent log output:\n' >&2
  tail -n 20 "$log_file" >&2 || true
  rm -f -- "$pid_file"
  return 1
}

open_workbench() {
  local mode="${1:-browser}"
  start_server
  printf 'SecretLoom is ready at %s\n' "$url"

  if [[ "$mode" == "app" ]] && command -v omarchy-launch-webapp >/dev/null 2>&1; then
    exec omarchy-launch-webapp "$url"
  fi

  if command -v xdg-open >/dev/null 2>&1; then
    setsid -f xdg-open "$url" >/dev/null 2>&1
    return 0
  fi

  printf 'Open %s in your browser.\n' "$url"
}

case "${1:-}" in
  "")
    open_workbench browser
    ;;
  --app)
    shift
    [[ $# -eq 0 ]] || { usage >&2; exit 2; }
    open_workbench app
    ;;
  --cli)
    shift
    require_install
    exec "$cli" "$@"
    ;;
  --status)
    if is_secretloom_ready; then
      printf 'SecretLoom is running at %s\n' "$url"
    else
      printf 'SecretLoom is not running.\n'
      exit 1
    fi
    ;;
  --stop)
    stop_server
    ;;
  --launcher-help)
    usage
    ;;
  *)
    require_install
    exec "$cli" "$@"
    ;;
esac
