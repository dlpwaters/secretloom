[Desktop Entry]
Version=1.0
Type=Application
Name=SecretLoom
GenericName=Steganography Workbench
Comment=Hide, reveal, and inspect data locally
Exec=secretloom --app
TryExec=secretloom
Icon=io.github.dlpwaters.SecretLoom
Terminal=false
StartupNotify=true
Categories=Utility;
Keywords=steganography;privacy;forensics;encode;decode;CTF;
Actions=CommandLine;StopServer;

[Desktop Action CommandLine]
Name=Open Command Line
Exec=xdg-terminal-exec --app-id=TUI.float -e secretloom --cli

[Desktop Action StopServer]
Name=Stop Local Server
Exec=secretloom --stop
